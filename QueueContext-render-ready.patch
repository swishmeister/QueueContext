+      - key: QUEUE_CONTEXT_USERNAME
+        value: queuecontext
+      - key: QUEUE_CONTEXT_PASSWORD
+        sync: false
+    disk:
+      name: queue-context-data
+      mountPath: /var/data
+      sizeGB: 1
